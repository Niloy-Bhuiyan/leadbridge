# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Every value here is optional. With none of them set the stack still runs
# end to end on the offline mock provider and the in-memory CRM, and
# GET /ops/availability will tell you exactly which integrations are idle
# and why.

# --- service ---------------------------------------------------------------
# Shared secret n8n sends as X-Leadbridge-Secret on every mutating call.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty ONLY for a loopback-bound local run; /ops/health reports
# "auth": "open" when it is unset, so the state is never invisible.
INGEST_SECRET=

# --- LLM -------------------------------------------------------------------
# auto = use Anthropic when a key is present, offline rules otherwise.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- CRM -------------------------------------------------------------------
# auto = use HubSpot when a token is present, in-memory CRM otherwise.
CRM_PROVIDER=auto
# HubSpot private app token. Required scopes:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
#   crm.objects.notes.write
HUBSPOT_TOKEN=

# --- SEO -------------------------------------------------------------------
# PageSpeed Insights answers without a key at a low rate limit. Set one to
# raise it: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# --- scheduled audit workflow ----------------------------------------------
# Newline- or comma-separated sites for the weekly audit workflow.
AUDIT_SITES=
# Slack or Discord incoming webhook for the audit digest.
ALERT_WEBHOOK_URL=
