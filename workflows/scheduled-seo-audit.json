{
  "name": "LeadBridge - scheduled client SEO audit",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [1],
              "triggerAtHour": 6,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Weekly Monday 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-620, 300]
    },
    {
      "parameters": {
        "jsCode": "// Sites to audit, newline-separated in the AUDIT_SITES env var.\n// Kept in configuration rather than hardcoded here so adding a client\n// does not mean editing and re-importing the workflow.\nconst raw = $env.AUDIT_SITES || '';\nconst sites = raw\n  .split(/[\\n,]/)\n  .map((s) => s.trim())\n  .filter(Boolean);\n\nif (sites.length === 0) {\n  // Report the misconfiguration instead of succeeding with zero work,\n  // which would look identical to a healthy run in the execution list.\n  throw new Error('AUDIT_SITES is not set; nothing to audit');\n}\n\nreturn sites.map((url) => ({ json: { url } }));"
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Load Client Sites",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "One Site At A Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-180, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LEADBRIDGE_URL || 'http://service:8000' }}/seo/audit",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Leadbridge-Secret",
              "value": "={{ $env.INGEST_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.url, include_psi: true, strategy: 'mobile' }) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Audit Site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [60, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "score-threshold",
              "leftValue": "={{ $json.score }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Score Below 70?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [280, 300]
    },
    {
      "parameters": {
        "jsCode": "// Build a readable digest line per site. Criticals are listed in full\n// because they are the ones worth waking someone for; warnings are\n// counted rather than enumerated.\nconst a = $json;\nconst criticals = (a.findings || []).filter((f) => f.severity === 'critical');\nconst warnings = (a.findings || []).filter((f) => f.severity === 'warning');\n\nreturn [\n  {\n    json: {\n      url: a.url,\n      score: a.score,\n      degraded: a.degraded === true,\n      critical_count: criticals.length,\n      warning_count: warnings.length,\n      criticals: criticals.map((f) => f.message),\n      summary: `${a.url} scored ${a.score}/100 with ${criticals.length} critical and ${warnings.length} warning findings.`,\n    },\n  },\n];"
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.summary, details: $json.criticals }) }}",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Notify Channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 220],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "notes": "Set ALERT_WEBHOOK_URL to a Slack or Discord incoming webhook. Left unset, this node fails and the run is marked degraded rather than silently dropping the alert."
    }
  ],
  "connections": {
    "Weekly Monday 06:00": {
      "main": [[{ "node": "Load Client Sites", "type": "main", "index": 0 }]]
    },
    "Load Client Sites": {
      "main": [[{ "node": "One Site At A Time", "type": "main", "index": 0 }]]
    },
    "One Site At A Time": {
      "main": [[], [{ "node": "Audit Site", "type": "main", "index": 0 }]]
    },
    "Audit Site": {
      "main": [[{ "node": "Score Below 70?", "type": "main", "index": 0 }]]
    },
    "Score Below 70?": {
      "main": [
        [{ "node": "Build Digest", "type": "main", "index": 0 }],
        [{ "node": "One Site At A Time", "type": "main", "index": 0 }]
      ]
    },
    "Build Digest": {
      "main": [[{ "node": "Notify Channel", "type": "main", "index": 0 }]]
    },
    "Notify Channel": {
      "main": [[{ "node": "One Site At A Time", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "leadbridge-local"
  },
  "tags": []
}
